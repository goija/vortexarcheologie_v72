import math
import matplotlib.pyplot as plt
import numpy as np

class WuXingApp:
    def __init__(self):
        # Toestandsvariabelen (One-hot 5D vector over GF(2))
        # Indexen: 0=Hout (Groen), 1=Vuur (Rood), 2=Aarde (Geel), 3=Metaal (Grijs), 4=Water (Blauw)
        self.state = [1, 0, 0, 0, 0]  # Start bij Hout
        self.elements_info = [
            {"name": "Hout", "color": "#2ca02c", "angle": 0 * 2 * math.pi / 5},
            {"name": "Vuur", "color": "#d62728", "angle": 1 * 2 * math.pi / 5},
            {"name": "Aarde", "color": "#bcbd22", "angle": 2 * 2 * math.pi / 5},
            {"name": "Metaal", "color": "#e0e0e0", "angle": 3 * 2 * math.pi / 5},
            {"name": "Water", "color": "#1f77b4", "angle": 4 * 2 * math.pi / 5}
        ]

        # Landauer & Thermodynamica Variabelen
        self.T = 298.15  # Kamertemperatuur in Kelvin
        self.erased_bits_count = 0
        self.kb = 1.380649e-23  # Boltzmann constante (J/K)
        self.q_to_ev = 1.602176634e-19  # Joule naar eV conversie factor

        # Hypotrochoïde parameters
        self.R = 220.0
        self.r = 160.0
        self.d = 230.0

        # Initial update of Landauer stats
        self.update_landauer_stats()

    def update_landauer_stats(self):
        T_val = self.T
        # Landauer-grens per bit: E = k_B * T * ln(2)
        E_limit = self.kb * T_val * math.log(2)
        E_limit_ev = E_limit / self.q_to_ev if self.q_to_ev > 0 else 0

        print(f"\n--- Landauer & Thermodynamica ---")
        print(f"Temperatuur (T): {T_val:.2f} K")
        print(f"Landauer-limiet/bit: {E_limit:.4e} J ({E_limit_ev * 1000:.3f} meV)")
        print(f"Gewiste bits (1 -> 0): {self.erased_bits_count}")
        
        total_heat = self.erased_bits_count * E_limit
        total_heat_ev = total_heat / self.q_to_ev if self.q_to_ev > 0 else 0
        print(f"Gedissipeerde warmte ΔQ: {total_heat:.4e} J ({total_heat_ev:.3e} eV)")
        print(f"-----------------------------------")

    def check_and_count_erasures(self, prev_state, next_state):
        # We tellen bit-wissingen: wanneer een bit van 1 naar 0 gaat
        erased = 0
        for p, n in zip(prev_state, next_state):
            if p == 1 and n == 0:
                erased += 1
        self.erased_bits_count += erased
        self.update_landauer_stats()

    def update_state_print(self):
        print(f"Current state: {self.state}")
        for i, elem in enumerate(self.elements_info):
            status = "Active" if self.state[i] == 1 else "Inactive"
            print(f"  {elem['name']}: {status}")

    def apply_sheng(self):
        prev = list(self.state)
        # Rotate Right over GF(2): x_new = M_S * x
        # [x0, x1, x2, x3, x4] -> [x4, x0, x1, x2, x3]
        self.state = [self.state[4]] + self.state[0:4]
        self.check_and_count_erasures(prev, self.state)
        self.update_state_print()
        self.draw_matplotlib_plot("Sheng (Voeden) - State Changed")

    def apply_ke(self):
        prev = list(self.state)
        # Rotate Right 2 positions over GF(2): x_new = M_K * x
        self.state = self.state[3:5] + self.state[0:3]
        self.check_and_count_erasures(prev, self.state)
        self.update_state_print()
        self.draw_matplotlib_plot("Ke (Bedwingen) - State Changed")

    def inject_xor(self):
        prev = list(self.state)
        # XOR storing: we toggelen de bit van Vuur
        self.state[1] = self.state[1] ^ 1
        self.check_and_count_erasures(prev, self.state)
        self.update_state_print()
        self.draw_matplotlib_plot("XOR Storing - State Changed")

    def reset_state(self):
        prev = list(self.state)
        self.state = [1, 0, 0, 0, 0]
        self.erased_bits_count = 0 # Reset erased bits on full state reset
        self.check_and_count_erasures(prev, self.state)
        self.update_state_print()
        self.draw_matplotlib_plot("Reset to Hout")

    def draw_matplotlib_plot(self, title="Wu Xing Hypotrochoid & State"):
        plt.figure(figsize=(10, 8))
        ax = plt.gca()
        ax.set_aspect('equal', adjustable='box')
        ax.set_facecolor("#0c0c0f")

        R_val = self.R
        r_val = self.r
        d_val = self.d

        # Bereken aantal stappen voor de hypotrochoïde om te sluiten
        try:
            R_int, r_int = int(round(R_val)), int(round(r_val))
            gcd = math.gcd(R_int, r_int) if r_int != 0 else R_int # Handle r_int == 0
            num_rotations = r_int // gcd if gcd != 0 else 1
        except Exception:
            num_rotations = 5

        max_theta = 2 * math.pi * num_rotations
        steps = 1000
        theta_vals = np.linspace(0, max_theta, steps + 1)

        # Hypotrochoïde parametrische vergelijking
        x = (R_val - r_val) * np.cos(theta_vals) + d_val * np.cos(((R_val - r_val) / r_val) * theta_vals)
        y = (R_val - r_val) * np.sin(theta_vals) - d_val * np.sin(((R_val - r_val) / r_val) * theta_vals)

        # Plot de curve met kleurverlopen per element
        for i in range(len(theta_vals) - 1):
            t1 = theta_vals[i]
            # Map de hoek t1 naar een van de 5 Wu Xing zones (0 tot 2pi)
            norm_angle = (t1 % (2 * math.pi)) / (2 * math.pi)
            elem_idx = int(norm_angle * 5) % 5
            color = self.elements_info[elem_idx]["color"]
            plt.plot(x[i:i+2], y[i:i+2], color=color, linewidth=2)

        # Teken de actieve elementen (gloeilicht effect op basis van binaire toestand)
        for i, elem in enumerate(self.elements_info):
            if self.state[i] == 1:
                # Bereken positie van de lob
                angle = elem["angle"]
                # For plotting, use actual R, r, d for central point
                ex_center = (R_val - r_val) * math.cos(angle) + d_val * math.cos(((R_val - r_val) / r_val) * angle)
                ey_center = (R_val - r_val) * math.sin(angle) - d_val * math.sin(((R_val - r_val) / r_val) * angle)

                # Create a glow effect with circles
                plt.scatter(ex_center, ey_center, s=500, color=elem["color"], alpha=0.3)
                plt.scatter(ex_center, ey_center, s=200, color=elem["color"], alpha=0.6)
                plt.scatter(ex_center, ey_center, s=50, color=elem["color"], edgecolors='white', linewidth=1)
                plt.text(ex_center, ey_center - 40, elem["name"], color="#ffffff", 
                         fontsize=11, fontweight='bold', ha='center', va='center')
        
        plt.title(title, color="#ffffff")
        plt.xlabel("X", color="#aaaaaa")
        plt.ylabel("Y", color="#aaaaaa")
        plt.xticks(color="#aaaaaa")
        plt.yticks(color="#aaaaaa")
        plt.grid(True, linestyle='--', alpha=0.3)
        plt.tight_layout()
        plt.show()
